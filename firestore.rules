rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /properties/{propertyId} {
      // 1. Public read: Anyone can read properties so real-time listeners work smoothly on public Vercel URLs
      allow read: if true;

      // 2. New listing creation: Any owner can submit a listing, but status MUST be 'pending'
      // Strictly enforces Requirement 3: Every new listing starts with status 'pending'
      allow create: if (request.resource.data.status == 'pending' || request.resource.data.status == 'PENDING')
                    && request.resource.data.title is string
                    && request.resource.data.monthlyRent is number;

      // 3. Update & Delete: Allows admin moderation approvals/rejections and owner updates
      allow update: if request.resource.data.title is string
                    && (request.resource.data.status in ['pending', 'PENDING', 'approved', 'APPROVED', 'rejected', 'REJECTED']);

      allow delete: if true;
    }

    match /tiffin_services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
