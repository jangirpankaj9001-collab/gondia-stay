rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to verify admin authorization
    function isAdmin() {
      return request.auth != null && (
        // Firebase custom claim: admin == true
        request.auth.token.admin == true
        // Or verified admin email match
        || (request.auth.token.email != null && (
          request.auth.token.email == 'jangirpankaj901@gmail.com'
          || request.auth.token.email.matches('(?i).*admin.*')
        ))
        // Or registered in Firestore admins collection
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Properties Collection: Gondia Stay listings
    match /properties/{propertyId} {
      // 1. Read: Public read allows real-time listener on public URL
      allow read: if true;

      // 2. Create: Anyone can submit new listings, strictly enforced as 'pending'
      // Strictly enforced server-side:
      // - Status MUST be 'pending' (no public submission can self-approve)
      // - Title must be non-empty string <= 150 chars
      // - Address must be non-empty string <= 300 chars
      // - Monthly rent must be a non-negative number <= 1,000,000
      // - Owner phone must be valid string (at least 5 characters)
      // - Cannot set isFeatured: true on create
      allow create: if request.resource.data.status in ['pending', 'PENDING']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 150
                    && request.resource.data.address is string
                    && request.resource.data.address.size() > 0
                    && request.resource.data.address.size() <= 300
                    && request.resource.data.locality is string
                    && request.resource.data.monthlyRent is number
                    && request.resource.data.monthlyRent >= 0
                    && request.resource.data.monthlyRent <= 1000000
                    && request.resource.data.ownerPhone is string
                    && request.resource.data.ownerPhone.size() >= 5
                    && (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured == false);

      // Helper function to verify that the updater is the cryptographically authenticated owner
      // Uses Firebase Auth token UID and verified email instead of trusting spoofable name/phone fields
      function isAuthorizedOwner() {
        return request.auth != null && (
          // 1. Document ownerId matches authenticated user's Firebase Auth UID
          (('ownerId' in resource.data) && resource.data.ownerId == request.auth.uid)
          // 2. Document ownerEmail matches authenticated user's verified email
          || (request.auth.token.email != null && (
            (('ownerEmail' in resource.data) && resource.data.ownerEmail == request.auth.token.email)
            || (('email' in resource.data) && resource.data.email == request.auth.token.email)
            // 3. Known default landlord email matches primary seed owner IDs
            || (('ownerId' in resource.data) && resource.data.ownerId in ['owner_gondia_primary', 'owner_gondia'] && request.auth.token.email == 'rajesh.sharma@gondiastay.com')
          ))
          // 4. Legacy listing without assigned ownerId: authenticated user can bind ownership
          || (!('ownerId' in resource.data) || resource.data.ownerId == '' || resource.data.ownerId == null)
        );
      }

      // Check permitted fields for owner listing update
      function hasOnlyPermittedListingUpdateKeys() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'address',
          'locality',
          'city',
          'propertyType',
          'accommodationType',
          'monthlyRent',
          'securityDeposit',
          'bedrooms',
          'bathrooms',
          'kitchenAvailable',
          'hallAvailable',
          'furnishing',
          'suitableTenants',
          'availableFrom',
          'amenities',
          'photos',
          'ownerId',
          'ownerName',
          'ownerPhone',
          'ownerWhatsappNumber',
          'ownerPreferredContact',
          'ownerEmail',
          'latitude',
          'longitude',
          'occupancyStatus',
          'isFeatured',
          'updatedAt'
        ]);
      }

      // Validation for permitted owner update (including Cloudinary photo URLs and listing fields)
      function isValidOwnerUpdate() {
        return hasOnlyPermittedListingUpdateKeys()
          // Listing approval status cannot be self-approved by owner
          && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'PENDING'] || ('status' in resource.data && request.resource.data.status == resource.data.status))
          // Owner cannot set featured flag to true
          && (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured == false || ('isFeatured' in resource.data && request.resource.data.isFeatured == resource.data.isFeatured))
          // Ownership integrity: Listing ownerId cannot be stolen or reassigned to another UID
          && (!('ownerId' in resource.data) || !('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.ownerId || request.resource.data.ownerId == request.auth.uid)
          // Creation timestamp cannot be tampered with
          && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          // Photo URLs validation (supports Cloudinary secure URLs and existing paths)
          && (!('photos' in request.resource.data) || (
            request.resource.data.photos is list
            && request.resource.data.photos.size() > 0
            && request.resource.data.photos.size() <= 30
          ))
          // Title validation
          && (!('title' in request.resource.data) || (
            request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 200
          ))
          // Address validation
          && (!('address' in request.resource.data) || (
            request.resource.data.address is string
            && request.resource.data.address.size() > 0
            && request.resource.data.address.size() <= 500
          ))
          // Rent validation
          && (!('monthlyRent' in request.resource.data) || (
            request.resource.data.monthlyRent is number
            && request.resource.data.monthlyRent >= 0
            && request.resource.data.monthlyRent <= 5000000
          ))
          // Contact phone validation
          && (!('ownerPhone' in request.resource.data) || (
            request.resource.data.ownerPhone is string
            && request.resource.data.ownerPhone.size() >= 5
          ))
          // Occupancy status validation
          && (!('occupancyStatus' in request.resource.data) || (
            request.resource.data.occupancyStatus in ['AVAILABLE', 'OCCUPIED', 'available', 'occupied']
          ));
      }

      // 3. Update:
      // - Admin has full update privileges (approval, rejection, edits, occupancy, featured).
      // - Authenticated Owner can update permitted listing fields (including Cloudinary photo URLs) or occupancy status.
      // - Cryptographically verifies request.auth.uid or verified ownerEmail without trusting unauthenticated ownerName/ownerPhone.
      allow update: if isAdmin() || (
        isAuthorizedOwner() && (
          // Fast path for occupancy status toggle
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['occupancyStatus', 'updatedAt'])
            && request.resource.data.occupancyStatus in ['AVAILABLE', 'OCCUPIED', 'available', 'occupied']
            && (!('status' in resource.data) || request.resource.data.status == resource.data.status)
          )
          // Full listing update with permitted fields (including Cloudinary photo URLs)
          || isValidOwnerUpdate()
        )
      );

      // 4. Delete: ONLY authenticated admin can delete listings.
      allow delete: if isAdmin();
    }

    // Owners collection for real owner profile data
    match /owners/{ownerId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == ownerId);
    }

    // Admins Collection (optional document-based admin registry)
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Tiffin Services Collection
    match /tiffin_services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
