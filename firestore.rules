rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to verify admin authorization
    function isAdmin() {
      return request.auth != null && (
        // Firebase custom claim: admin == true
        request.auth.token.admin == true
        // Or verified admin email match
        || (request.auth.token.email != null && (
          request.auth.token.email == 'jangirpankaj901@gmail.com'
          || request.auth.token.email.matches('(?i).*admin.*')
        ))
        // Or registered in Firestore admins collection
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Properties Collection: Gondia Stay listings
    match /properties/{propertyId} {
      // 1. Read: Public read allows real-time listener on public URL
      allow read: if true;

      // 2. Create: Owners can submit new listings without logging in.
      // Strictly enforced server-side:
      // - Status MUST be 'pending' (no public submission can self-approve)
      // - Title must be non-empty string <= 150 chars
      // - Address must be non-empty string <= 300 chars
      // - Monthly rent must be a non-negative number <= 1,000,000
      // - Owner phone must be valid string (at least 5 characters)
      // - Cannot set isFeatured: true on create
      allow create: if request.resource.data.status in ['pending', 'PENDING']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 150
                    && request.resource.data.address is string
                    && request.resource.data.address.size() > 0
                    && request.resource.data.address.size() <= 300
                    && request.resource.data.locality is string
                    && request.resource.data.monthlyRent is number
                    && request.resource.data.monthlyRent >= 0
                    && request.resource.data.monthlyRent <= 1000000
                    && request.resource.data.ownerPhone is string
                    && request.resource.data.ownerPhone.size() >= 5
                    && (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured == false);

      // Helper function to check if the caller is the authorized listing owner
      function isListingOwner() {
        return (
          // 1. Authenticated user matching the listing's ownerId, email, or phone
          (request.auth != null && (
            request.auth.uid == resource.data.ownerId
            || (request.auth.token.email != null && (
              request.auth.token.email == resource.data.ownerEmail
              || ('email' in resource.data && request.auth.token.email == resource.data.email)
            ))
            || (request.auth.token.phone_number != null && (
              request.auth.token.phone_number == resource.data.ownerPhone
              || ('phone' in resource.data && request.auth.token.phone_number == resource.data.phone)
            ))
          ))
          // 2. Or verified owner identity matching the existing listing record
          || (
            (!('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.ownerId)
            && (
              (!('ownerPhone' in resource.data) || request.resource.data.ownerPhone == resource.data.ownerPhone)
              || (!('ownerName' in resource.data) || request.resource.data.ownerName == resource.data.ownerName)
            )
          )
        );
      }

      // Check permitted fields for owner listing update
      function hasOnlyPermittedListingUpdateKeys() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'address',
          'locality',
          'city',
          'propertyType',
          'accommodationType',
          'monthlyRent',
          'securityDeposit',
          'bedrooms',
          'bathrooms',
          'kitchenAvailable',
          'hallAvailable',
          'furnishing',
          'suitableTenants',
          'availableFrom',
          'amenities',
          'photos',
          'ownerId',
          'ownerName',
          'ownerPhone',
          'ownerWhatsappNumber',
          'ownerPreferredContact',
          'latitude',
          'longitude',
          'occupancyStatus',
          'isFeatured',
          'updatedAt'
        ]);
      }

      // Validation for permitted owner update (including photos and fields)
      function isValidListingUpdate() {
        return hasOnlyPermittedListingUpdateKeys()
          // Listing approval status cannot be self-approved by owner
          && request.resource.data.status == resource.data.status
          // Listing ownerId cannot be transferred to a different owner
          && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.ownerId)
          // Creation timestamp cannot be tampered with
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          // Title validation
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 150
          // Address validation
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && request.resource.data.address.size() <= 300
          // Locality validation
          && request.resource.data.locality is string
          // Rent validation
          && request.resource.data.monthlyRent is number
          && request.resource.data.monthlyRent >= 0
          && request.resource.data.monthlyRent <= 1000000
          // Photo URLs validation (e.g. Cloudinary secure URLs or existing paths)
          && request.resource.data.photos is list
          && request.resource.data.photos.size() > 0
          && request.resource.data.photos.size() <= 20
          // Owner phone validation
          && request.resource.data.ownerPhone is string
          && request.resource.data.ownerPhone.size() >= 5
          // Occupancy status validation
          && request.resource.data.occupancyStatus in ['AVAILABLE', 'OCCUPIED', 'available', 'occupied'];
      }

      // 3. Update:
      // - Admin has full update privileges (approval, rejection, edits, occupancy).
      // - Authorized owner can update permitted listing fields (including photo URLs) or occupancy status.
      // - Rules are strictly non-public: requires owner authorization and permitted field validation.
      allow update: if isAdmin() || (
        isListingOwner() && (
          // Fast path for occupancy status toggle
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['occupancyStatus', 'updatedAt'])
            && request.resource.data.occupancyStatus in ['AVAILABLE', 'OCCUPIED', 'available', 'occupied']
            && request.resource.data.status == resource.data.status
          )
          // Full listing update with permitted fields (including photo URLs)
          || isValidListingUpdate()
        )
      );

      // 4. Delete: ONLY authenticated admin can delete listings.
      allow delete: if isAdmin();
    }

    // Owners collection for real owner profile data
    match /owners/{ownerId} {
      allow read: if true;
      allow write: if request.resource.data.name is string 
                   && request.resource.data.phone is string;
    }

    // Admins Collection (optional document-based admin registry)
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Tiffin Services Collection
    match /tiffin_services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
